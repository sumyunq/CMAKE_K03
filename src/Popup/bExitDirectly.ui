      <property name="styleSheet">
       <string notr="true">QCheckBox {
    color: #616975;
    font-family: &quot;Noto Sans S Chinese&quot;; font-weight: 500;
    font-size: 10px;
}

QCheckBox::indicator {
    height: 12px;
    width: 12px;
    border-image: url(:/Skin/Images/close/remember-no.png);
    margin-right: 9px;
}

/* 未选中 + 悬停 */
QCheckBox::indicator:unchecked:hover {
    border-image: url(:/Skin/Images/close/remember-no-ho.png);
}

/* 选中状态 */
QCheckBox::indicator:checked {
    border-image: url(:/Skin/Images/close/remember-se.png);
}

/* 选中 + 悬停 */
QCheckBox::indicator:checked:hover {
    border-image: url(:/Skin/Images/close/remember-se-ho.png);
}</string>
